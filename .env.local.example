# Copy to .env.local and fill in real values before deploying.
# Without this file, the app falls back to an insecure dev-only password —
# never rely on that fallback outside local development.

# Password for the staff admin CMS at /admin/login
ADMIN_PASSWORD=choose-a-real-password

# Random string used to sign the admin session cookie (any long random value)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
